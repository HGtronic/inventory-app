# Optional settings. Nothing here is required: by default the backend listens
# on 8001 and the frontend calls http://localhost:8001/api.

# Backend port, read by server/main.py and scripts/start.sh / stop.sh.
# Set it in your shell, e.g. `API_PORT=8002 uv run python main.py`.
# API_PORT=8001

# API base URL used by the frontend. Vite reads it from client/.env
# (gitignored), so copy this line there when the backend runs elsewhere.
# VITE_API_BASE_URL=http://localhost:8001/api
